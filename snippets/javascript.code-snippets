  "JavaScript fetch with AbortController": {
    "prefix": "fetchabort",
    "body": [
      "const controller = new AbortController();",
      "",
      "try {",
      "  const response = await fetch(\"${1:/api/data}\", {",
      "    signal: controller.signal,",
      "  });",
      "",
      "  if (!response.ok) {",
      "    throw new Error(`Request failed: ${response.status}`);",
      "  }",
      "",
      "  const ${2:data} = await response.json();",
      "  $0",
      "} finally {",
      "  controller.abort();",
      "}"
    ],
    "description": "JavaScript fetch with AbortController"
  },
  "JavaScript debounce function": {
    "prefix": "debounce",
    "body": [
      "function debounce(${1:fn}, ${2:delayMs} = 300) {",
      "  let timer;",
      "",
      "  return function debounced(...args) {",
      "    clearTimeout(timer);",
      "    timer = setTimeout(() => ${1:fn}(...args), ${2:delayMs});",
      "  };",
      "}"
    ],
    "description": "JavaScript debounce function"
  },
  "JavaScript throttle function": {
    "prefix": "throttle",
    "body": [
      "function throttle(${1:fn}, ${2:limitMs} = 300) {",
      "  let inThrottle = false;",
      "",
      "  return function throttled(...args) {",
      "    if (inThrottle) return;",
      "    inThrottle = true;",
      "    ${1:fn}(...args);",
      "    setTimeout(() => { inThrottle = false; }, ${2:limitMs});",
      "  };",
      "}"
    ],
    "description": "JavaScript throttle function"
  },
