{
  "CSS flexbox center": {
    "prefix": "flexcenter",
    "body": [
      "display: flex;",
      "align-items: center;",
      "justify-content: center;"
    ],
    "description": "CSS flexbox center"
  },
  "CSS flex column layout": {
    "prefix": "flexcol",
    "body": [
      "display: flex;",
      "flex-direction: column;",
      "gap: ${1:1rem};"
    ],
    "description": "CSS flex column layout"
  },
  "CSS flex row layout": {
    "prefix": "flexrow",
    "body": [
      "display: flex;",
      "flex-direction: row;",
      "gap: ${1:1rem};"
    ],
    "description": "CSS flex row layout"
  },
  "CSS grid center": {
    "prefix": "gridcenter",
    "body": [
      "display: grid;",
      "place-items: center;"
    ],
    "description": "CSS grid center"
  },
  "CSS grid layout": {
    "prefix": "grid",
    "body": [
      "display: grid;",
      "grid-template-columns: repeat(${1:3}, 1fr);",
      "gap: ${2:1rem};"
    ],
    "description": "CSS grid layout"
  },
  "CSS media query": {
    "prefix": "media",
    "body": [
      "@media (min-width: ${1:768px}) {",
      "  $0",
      "}"
    ],
    "description": "CSS media query"
  },
  "CSS keyframes animation": {
    "prefix": "keyframes",
    "body": [
      "@keyframes ${1:animationName} {",
      "  from {",
      "    $2",
      "  }",
      "  to {",
      "    $0",
      "  }",
      "}"
    ],
    "description": "CSS keyframes animation"
  },
  "CSS animation property": {
    "prefix": "animation",
    "body": "animation: ${1:name} ${2:1s} ${3|ease,ease-in,ease-out,ease-in-out,linear|} ${4:0s} ${5|normal,reverse,alternate|} ${6:1} ${7|running,paused|};",
    "description": "CSS animation property"
  },
  "CSS custom properties block": {
    "prefix": "vars",
    "body": [
      ":root {",
      "  --${1:name}: ${2:value};",
      "  $0",
      "}"
    ],
    "description": "CSS custom properties block"
  },
  "CSS custom property reference": {
    "prefix": "var",
    "body": "var(--${1:name}, ${2:fallback})",
    "description": "CSS custom property reference"
  },
  "CSS box-sizing reset": {
    "prefix": "boxreset",
    "body": [
      "*,",
      "*::before,",
      "*::after {",
      "  box-sizing: border-box;",
      "}"
    ],
    "description": "CSS box-sizing reset"
  },
  "CSS absolute center": {
    "prefix": "abscenter",
    "body": [
      "position: absolute;",
      "top: 50%;",
      "left: 50%;",
      "transform: translate(-50%, -50%);"
    ],
    "description": "CSS absolute center"
  },
  "CSS position sticky": {
    "prefix": "sticky",
    "body": [
      "position: sticky;",
      "top: ${1:0};",
      "z-index: ${2:10};"
    ],
    "description": "CSS position sticky"
  },
  "CSS text truncate ellipsis": {
    "prefix": "truncate",
    "body": [
      "overflow: hidden;",
      "text-overflow: ellipsis;",
      "white-space: nowrap;"
    ],
    "description": "CSS text truncate ellipsis"
  },
  "CSS multi-line clamp": {
    "prefix": "lineclamp",
    "body": [
      "display: -webkit-box;",
      "-webkit-line-clamp: ${1:3};",
      "-webkit-box-orient: vertical;",
      "overflow: hidden;"
    ],
    "description": "CSS multi-line clamp"
  },
  "CSS focus-visible outline": {
    "prefix": "focusvis",
    "body": [
      "&:focus-visible {",
      "  outline: 2px solid ${1:currentColor};",
      "  outline-offset: 2px;",
      "}"
    ],
    "description": "CSS focus-visible outline"
  },
  "CSS hover with transition": {
    "prefix": "hover",
    "body": [
      "transition: ${1:all} ${2:200ms} ${3|ease,ease-in,ease-out,ease-in-out,linear|};",
      "",
      "&:hover {",
      "  $0",
      "}"
    ],
    "description": "CSS hover with transition"
  },
  "CSS container query": {
    "prefix": "container",
    "body": [
      "container-type: inline-size;",
      "",
      "@container (min-width: ${1:400px}) {",
      "  $0",
      "}"
    ],
    "description": "CSS container query"
  },
  "CSS aspect ratio": {
    "prefix": "aspect",
    "body": "aspect-ratio: ${1:16} / ${2:9};",
    "description": "CSS aspect ratio"
  },
  "CSS screen reader only": {
    "prefix": "sronly",
    "body": [
      "position: absolute;",
      "width: 1px;",
      "height: 1px;",
      "padding: 0;",
      "margin: -1px;",
      "overflow: hidden;",
      "clip: rect(0, 0, 0, 0);",
      "white-space: nowrap;",
      "border: 0;"
    ],
    "description": "CSS screen reader only"
  },
  "CSS linear gradient": {
    "prefix": "gradient",
    "body": "background: linear-gradient(${1:180deg}, ${2:#000}, ${3:#fff});",
    "description": "CSS linear gradient"
  },
  "CSS box shadow": {
    "prefix": "shadow",
    "body": "box-shadow: ${1:0} ${2:4px} ${3:12px} rgba(0, 0, 0, ${4:0.15});",
    "description": "CSS box shadow"
  },
  "CSS border radius": {
    "prefix": "radius",
    "body": "border-radius: ${1:8px};",
    "description": "CSS border radius"
  },
  "CSS system font stack": {
    "prefix": "fontstack",
    "body": "font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;",
    "description": "CSS system font stack"
  },
  "CSS margin padding reset": {
    "prefix": "resetmp",
    "body": [
      "margin: 0;",
      "padding: 0;"
    ],
    "description": "CSS margin padding reset"
  },
  "CSS modern minimal reset": {
    "prefix": "modernreset",
    "body": [
      "*,",
      "*::before,",
      "*::after {",
      "  box-sizing: border-box;",
      "}",
      "",
      "html:focus-within {",
      "  scroll-behavior: smooth;",
      "}",
      "",
      "body {",
      "  min-height: 100vh;",
      "  line-height: 1.5;",
      "  text-rendering: optimizeLegibility;",
      "  -webkit-font-smoothing: antialiased;",
      "}",
      "",
      "img, picture, video, canvas, svg {",
      "  display: block;",
      "  max-width: 100%;",
      "}"
    ],
    "description": "CSS modern minimal reset"
  },
  "CSS fluid typography with clamp": {
    "prefix": "fluidtype",
    "body": "font-size: clamp(${1:1rem}, ${2:0.5rem} + ${3:2vw}, ${4:2rem});",
    "description": "CSS fluid typography with clamp"
  },
  "CSS prefers-reduced-motion guard": {
    "prefix": "reducedmotion",
    "body": [
      "@media (prefers-reduced-motion: reduce) {",
      "  *,",
      "  *::before,",
      "  *::after {",
      "    animation-duration: 0.01ms !important;",
      "    animation-iteration-count: 1 !important;",
      "    transition-duration: 0.01ms !important;",
      "    scroll-behavior: auto !important;",
      "  }",
      "}"
    ],
    "description": "CSS prefers-reduced-motion guard"
  },
  "CSS prefers-color-scheme dark mode": {
    "prefix": "darkmode",
    "body": [
      "@media (prefers-color-scheme: dark) {",
      "  :root {",
      "    color-scheme: dark;",
      "    $0",
      "  }",
      "}"
    ],
    "description": "CSS prefers-color-scheme dark mode"
  },
  "CSS backdrop blur glass effect": {
    "prefix": "backdrop",
    "body": [
      "background: rgba(255, 255, 255, ${1:0.72});",
      "backdrop-filter: blur(${2:12px});",
      "-webkit-backdrop-filter: blur(${2:12px});"
    ],
    "description": "CSS backdrop blur glass effect"
  },
  "CSS scroll snap container": {
    "prefix": "scrollsnap",
    "body": [
      "display: flex;",
      "overflow-x: auto;",
      "scroll-snap-type: x mandatory;",
      "gap: ${1:1rem};",
      "",
      "& > * {",
      "  scroll-snap-align: start;",
      "  flex: 0 0 ${2:80%};",
      "}"
    ],
    "description": "CSS scroll snap container"
  },
  "CSS cascade layer": {
    "prefix": "layer",
    "body": [
      "@layer ${1:base}, ${2:components}, ${3:utilities};",
      "",
      "@layer ${1:base} {",
      "  $0",
      "}"
    ],
    "description": "CSS cascade layer"
  },
  "CSS :is() selector group": {
    "prefix": "iswhere",
    "body": ":is(${1:h1}, ${2:h2}, ${3:h3}) {",
    "description": "CSS :is() selector group"
  },
  "CSS logical properties": {
    "prefix": "logical",
    "body": [
      "inline-size: ${1:100%};",
      "block-size: ${2:auto};",
      "padding-inline: ${3:1rem};",
      "padding-block: ${4:0.5rem};"
    ],
    "description": "CSS logical properties"
  },
  "CSS subgrid layout": {
    "prefix": "subgrid",
    "body": [
      "display: grid;",
      "grid-template-columns: subgrid;",
      "grid-column: span ${1:3};"
    ],
    "description": "CSS subgrid layout"
  },
  "CSS inset box shadow": {
    "prefix": "insetshadow",
    "body": "box-shadow: inset 0 1px 2px rgba(0, 0, 0, ${1:0.08});",
    "description": "CSS inset box shadow"
  },
  "CSS fit-content sizing": {
    "prefix": "fitcontent",
    "body": "width: fit-content; max-width: 100%;",
    "description": "CSS fit-content sizing"
  },
  "CSS :has() parent selector": {
    "prefix": "has",
    "body": [
      "&:has(${1:> img}) {",
      "  $0",
      "}"
    ],
    "description": "CSS :has() parent selector"
  },
  "CSS oklch perceptual color": {
    "prefix": "oklch",
    "body": "color: oklch(${1:0.7} ${2:0.12} ${3:250});",
    "description": "CSS oklch perceptual color"
  },
  "CSS color-mix function": {
    "prefix": "colormix",
    "body": "background-color: color-mix(in oklch, ${1:var(--accent)} ${2:80%}, ${3:white});",
    "description": "CSS color-mix function"
  },
  "CSS native nesting block": {
    "prefix": "nest",
    "body": [
      ".${1:block} {",
      "  $2",
      "",
      "  & ${3:__element} {",
      "    $0",
      "  }",
      "}"
    ],
    "description": "CSS native nesting block"
  },
  "CSS responsive auto-fit grid": {
    "prefix": "gridfit",
    "body": [
      "display: grid;",
      "grid-template-columns: repeat(auto-fit, minmax(min(${1:16rem}, 100%), 1fr));",
      "gap: ${2:1rem};"
    ],
    "description": "CSS responsive auto-fit grid"
  },
  "CSS view transition name": {
    "prefix": "viewtrans",
    "body": "view-transition-name: ${1:hero-image};",
    "description": "CSS view transition name"
  },
  "CSS print media query": {
    "prefix": "print",
    "body": [
      "@media print {",
      "  body {",
      "    color: #000;",
      "    background: #fff;",
      "  }",
      "",
      "  a[href]::after {",
      "    content: \" (\" attr(href) \")\";",
      "  }",
      "",
      "  $0",
      "}"
    ],
    "description": "CSS print media query"
  },
  "CSS focus-within ring for form groups": {
    "prefix": "focuswithin",
    "body": [
      "&:focus-within {",
      "  outline: 2px solid ${1:var(--focus-ring, currentColor)};",
      "  outline-offset: 2px;",
      "}"
    ],
    "description": "CSS focus-within ring for form groups"
  }
}
