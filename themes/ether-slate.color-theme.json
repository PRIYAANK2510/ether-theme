  "tokenColors": [
    {
      "settings": {
        "foreground": "#D8E0EC"
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "markup.quote.markdown",
        "meta.diff",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#687080",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "text.html.php string",
        "markup.inline.raw",
        "punctuation.definition.string",
        "punctuation.definition.markdown",
        "text.html meta.embedded source.js string",
        "text.html.php punctuation.definition.string",
        "text.html meta.embedded source.js punctuation.definition.string",
        "text.html punctuation.definition.string",
        "text.html string",
        "text.html.markdown string.quoted",
        "text.xml string",
        "text.xml punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#88C888"
      }
    },
    {
      "name": "Number / CSS Unit",
      "scope": [
        "constant.numeric",
        "source.css keyword.other.unit"
      ],
      "settings": {
        "foreground": "#E8B050"
      }
    },
    {
      "name": "Constant — Language & Built-in",
      "scope": [
        "constant",
        "constant.language",
        "support.constant",
        "constant.other.php",
        "support.constant.ext.php",
        "constant.other.class.php",
        "support.constant.core.php",
        "constant.other.caps.python",
        "constant.character.entity.html"
      ],
      "settings": {
        "foreground": "#58C0D0"
      }
    },
    {
      "name": "TypeScript Primitive Types",
      "scope": [
        "support.type.primitive.ts",
        "support.type.builtin.ts"
      ],
      "settings": {
        "foreground": "#58C0D0"
      }
    },
    {
      "name": "Keyword / Storage",
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#8898E8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#58C0D0"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#6B9FD4"
      }
    },
    {
      "name": "This / Self",
      "scope": [
        "variable.language.this",
        "variable.language.this.js",
        "variable.language.special.self.python",
        "variable.language"
      ],
      "settings": {
        "foreground": "#E87888",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Object Property",
      "scope": [
        "variable.other.object.property.js.jsx",
        "variable.other.object.js",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#E8B050"
      }
    },
    {
      "name": "Embedded / Template Expression Text",
      "scope": [
        "meta.template.expression.js",
        "constant.name.attribute.tag.jade"
      ],
      "settings": {
        "foreground": "#D8E0EC"
      }
    },
    {
      "name": "Function / Method",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.magic.python",
        "meta.function-call.generic.python",
        "source.css support.function",
        "source.php support.function"
      ],
      "settings": {
        "foreground": "#78C0F8"
      }
    },
    {
      "name": "Type / Class",
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type.exception.python",
        "source.js support.type"
      ],
      "settings": {
        "foreground": "#E8C860"
      }
    },
    {
      "name": "Inherited Class",
      "scope": [
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#E8C860",
        "fontStyle": "italic underline"
      }
    },
    {
      "name": "HTML / JSX Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E87888"
      }
    },
    {
      "name": "Attribute Name",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E8B050",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS ID Selector",
      "scope": [
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#E8C860",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Tag / Parent Selector",
      "scope": [
        "source.css entity.name.tag.reference",
        "source.css entity.other.attribute-name.parent-selector"
      ],
      "settings": {
        "foreground": "#E87888"
      }
    },
    {
      "name": "CSS Keyframe Offset",
      "scope": [
        "entity.other.keyframe-offset.css"
      ],
      "settings": {
        "foreground": "#E8B050"
      }
    },
    {
      "name": "CSS At-Rule Extend",
      "scope": [
        "meta.at-rule.extend",
        "meta.at-rule.extend support.constant"
      ],
      "settings": {
        "foreground": "#8898E8"
      }
    },
    {
      "name": "JSON / YAML Keys",
      "scope": [
        "meta.structure.dictionary.json support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#78C0F8"
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "string.regexp",
        "meta.group.regexp"
      ],
      "settings": {
        "foreground": "#58C0D0"
      }
    },
    {
      "name": "Template Expression Delimiters",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.definition.interpolation",
        "punctuation.section.embedded.begin.php",
        "punctuation.section.embedded.end.php",
        "punctuation.section.embedded.begin.ruby",
        "punctuation.section.embedded.end.ruby"
      ],
      "settings": {
        "foreground": "#E898B8"
      }
    },
    {
      "name": "Markup — Heading",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#6B9FD4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup — Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E8B050",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup — Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#8898E8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup — List",
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#E87888"
      }
    },
    {
      "name": "Markdown List Bullet",
      "scope": [
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#E8B050"
      }
    },
    {
      "name": "Markup — Link / Image",
      "scope": [
        "meta.link",
        "meta.image"
      ],
      "settings": {
        "foreground": "#6B9FD4"
      }
    },
    {
      "name": "Markup — Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#88C888"
      }
    },
    {
      "name": "Markup — Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E87888"
      }
    },
    {
      "name": "Markup — Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E8B050"
      }
    },
    {
      "name": "Markdown Metadata Punctuation",
      "scope": [
        "punctuation.definition.metadata.markdown",
        "punctuation.definition.string.end.markdown",
        "punctuation.definition.string.begin.markdown"
      ],
      "settings": {
        "foreground": "#D8E0EC"
      }
    },
    {
      "name": "Fenced Code Block Language",
      "scope": [
        "fenced_code.block.language"
      ],
      "settings": {
        "foreground": "#E8B050"
      }
    },
    {
      "name": "Jade / Pug Class Attribute",
      "scope": [
        "entity.other.attribute-name.class.jade"
      ],
      "settings": {
        "foreground": "#E8C860"
      }
    }
  ]
}
