{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "checkJs": false,
    "maxNodeModuleJsDepth": 0
  },
  "typeAcquisition": {
    "enable": false
  },
  "include": ["src/**/*.js", "tests/**/*.js"],
  "exclude": ["node_modules", "themes", "releases"]
}
