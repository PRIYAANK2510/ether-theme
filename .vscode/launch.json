{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Ether Theme Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/**/*.js"],
      "preLaunchTask": "build",
      "presentation": {
        "group": "ether",
        "order": 1
      }
    }
  ]
}
