{
  "json.schemas": [
    {
      "fileMatch": ["themes/*.color-theme.json"],
      "url": "vscode://schemas/color-theme"
    }
  ],
  "debug.toolBarLocation": "docked",
  "debug.onTaskErrors": "showErrors",
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.preferences.preferGoToSourceDefinition": true,
  "typescript.preferences.useAliasesForRenames": false,
  "typescript.tsserver.maxTsServerMemory": 4096,
  "eslint.workingDirectories": [
    { "pattern": "apps/website" },
    { "mode": "auto" }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "javascript.validate.enable": true,
  "terminal.integrated.env.windows": {
    "PATH": "${env:PATH};${env:ProgramFiles}\\nodejs;${env:APPDATA}\\npm"
  },
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "site": true,
    "releases": true,
    "apps/website/public": true,
    "apps/website/src/generated": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "site/**": true,
    "releases/**": true,
    "apps/website/public/**": true,
    "apps/website/src/generated/**": true
  },
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  "stylelint.validate": ["css", "scss"],
  "stylelint.snippet": ["css", "scss"],
  "files.associations": {
    "*.module.scss": "scss"
  },
  "[scss]": {
    "editor.defaultFormatter": "syler.sass-indented"
  },
  "vitest.enable": true,
  "vitest.rootConfig": "vitest.config.js"
}
