  "scripts": {
    "build": "node src/build.js",
    "build:extension": "node src/build.js --skip-previews",
    "web:prepare": "node web/scripts/prepare-data.mjs",
    "web:dev": "npm run web:prepare && vite --config web/vite.config.ts",
    "web:build": "node web/scripts/build.mjs",
    "docs:site": "npm run web:build",
    "docs:snippets": "npm run docs:site",
    "snippets:sync": "node src/snippets/catalog/sync-es7-extension.mjs",
    "watch": "node --watch --watch-path=src src/build.js",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build",
    "vscode:prepublish": "npm run build",
    "prepackage": "node --input-type=module -e \"import { mkdirSync } from 'node:fs'; mkdirSync('releases', { recursive: true });\"",
    "package": "vsce package --out releases/",
    "publish": "node scripts/publish.js",
    "publish:local": "dotenv -e .env -- npm run publish"
  },
  "vsce": {
    "yarn": false,
    "dependencies": false
