# Normalize text files to LF in the repo on every platform.
* text=auto eol=lf

*.md            text eol=lf
*.json          text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.scss          text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sh            text eol=lf
*.code-snippets text eol=lf
*.color-theme.json text eol=lf

*.png           binary
*.vsix          binary
*.woff2         binary
